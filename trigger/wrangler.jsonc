{
  // Timer only: no web address. Deployed by .github/workflows/deploy-trigger.yml, never by hand.
  "name": "jays-bracket-plays-trigger",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "triggers": {
    // The first line matches daily-update.yml. The second is Selection Sunday 2027, every 5 minutes 11:01 a.m.-6:56 p.m. EDT (worker.js); update each season.
    "crons": ["17 10 * 11-12,1-4 *", "1-56/5 15-22 14 3 *"]
  },
  // Selection Sunday: freeze, verify and backup run inside the private review Worker through this binding (no public route).
  "services": [{ "binding": "REVIEW", "service": "jbp-review", "entrypoint": "ReviewOps" }]
}
