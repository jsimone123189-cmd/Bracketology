{
  // Owner-only review Worker (docs/44-45). Deployed only by .github/workflows/review-deploy.yml, run by hand after the owner's approval.
  // Never run `wrangler deploy` by hand. Local testing: `npm test` (wrangler dev with local D1 copies; nothing leaves this machine).
  "name": "jbp-review",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  // The only public address is the custom domain below, which sits behind the Cloudflare Access application "JBP Review"
  // (Owner only). workers.dev and preview URLs would skip Access, so both are off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "review.jaysbracketplays.com", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "d1_databases": [
    // Database ids are not secret (they are useless without an account token).
    { "binding": "DB", "database_name": "jbp_private", "database_id": "56de15f9-1eb0-499a-9c89-e5954da11203", "migrations_dir": "migrations" },
    { "binding": "BACKUP", "database_name": "jbp_backup", "database_id": "8b399f05-0356-4175-b03f-964fca1371c9", "migrations_dir": "migrations-backup" }
  ],
  // Daily automatic backup at 09:23 UTC (4:23/5:23 a.m. ET).
  "triggers": { "crons": ["23 9 * * *"] },
  // Workers Logs record each request's CPU time (checked in stage 2). The Worker logs no private data.
  "observability": { "enabled": true },
  "vars": { "SEASON": "2027" }
  // Worker secrets, uploaded with the deploy (never in this public file): ACCESS_TEAM_DOMAIN, ACCESS_AUD, OWNER_EMAIL
  // (stage 2 adds MACHINE_CLIENT_ID). While any of the first three is missing, every request is refused.
}
