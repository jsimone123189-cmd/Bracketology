{
  // Owner-only review Worker (docs/44-45). NOT DEPLOYED. Deploying needs the owner's approval (docs/45, stage 1).
  // Never run `wrangler deploy` by hand. Local testing: `npm test` (wrangler dev with local D1 copies; nothing leaves this machine).
  "name": "jbp-review",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  // No public address except the Access-protected custom domain added at deploy. workers.dev and preview URLs would skip Access.
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "d1_databases": [
    // Placeholder ids: neither database exists yet (stage 1 creates them).
    { "binding": "DB", "database_name": "jbp_private", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
    { "binding": "BACKUP", "database_name": "jbp_backup", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations-backup" }
  ],
  // Daily automatic backup at 09:23 UTC (4:23/5:23 a.m. ET). One cron trigger; the account would use 4 of the free 5.
  "triggers": { "crons": ["23 9 * * *"] },
  // Workers Logs record each request's CPU time (needed to check the 10 ms free limit in stage 2). The Worker logs no private data.
  "observability": { "enabled": true },
  "vars": { "SEASON": "2027" }
  // Set as Worker secrets at deploy (never in this public file): ACCESS_TEAM_DOMAIN, ACCESS_AUD, OWNER_EMAIL, MACHINE_CLIENT_ID.
  // While any of the first three is missing, every request is refused.
}
